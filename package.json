{
  "name": "nara-hybrid-decision-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate": "tsx src/server/evaluate.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "18.19.86",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "8.2.2",
    "tsx": "3.14.0",
    "typescript": "5.4.5",
    "vite": "4.5.14",
    "vitest": "0.34.6"
  }
}
